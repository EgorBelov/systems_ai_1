# Строка подключения Supabase Postgres.
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Для serverless на Vercel используйте Connection Pooling (Transaction, порт 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 1 = cookie только по HTTPS (обязательно для Vercel).
# Локально по http выставите 0, иначе cookie не отправится.
COOKIE_SECURE=1
